# Copy this file to .env and fill in the values. Never commit .env.

# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Your Discord server ID (right-click the server -> Copy Server ID, with Developer Mode on).
# When set, slash commands appear in that server instantly.
GUILD_ID=

# Role ID for hosts (right-click the role in Server Settings -> Roles -> Copy Role ID).
# Members with Manage Server can always use host commands too.
HOST_ROLE_ID=

# Role to @mention in the weekly availability reminder (e.g. your CQ players role).
# Leave empty for no ping. In Server Settings > Roles, turn on "Allow anyone to @mention
# this role" (or give the bot "Mention @everyone, @here, and All Roles").
PLAYER_ROLE_ID=

# Channel for the weekly reminder. Optional: hosts can also set it with /config reminders.
CQ_CHANNEL_ID=

# Channel where hosts post damage logs. Optional: by default the bot watches any channel
# named #queen-logs, and hosts can also set it with /config damage_logs.
QUEEN_LOGS_CHANNEL_ID=

# Timezone that defines the Sunday week start and the reminder/deadline times.
BOT_TIMEZONE=America/New_York

# Game server timezone, used to read [Start Time]/[Finish Time] in damage logs.
LOG_TIMEZONE=Australia/Sydney

# Where the SQLite database lives (created automatically). Relative paths are from the project root.
DATABASE_PATH=data/monkey_inc.db

# Files used to fill an empty database on first start.
SEED_ROSTER_CSV=bot_data/Monkey, Inc.  - CQ Roster.csv
SEED_SQUAD_TIMINGS=bot_data/squad_timings.txt

# Class icons: one image per class, named after the job (DRK.png, NL.png, ...). The bot keeps
# its icons in step with this folder (checked at startup and every 10 minutes).
CLASS_ICONS_DIR=bot_data/class_icons

# Who players should message to add new characters (shown in /cq characters). A name, or a
# Discord mention like <@123456789012345678> so it's clickable. Defaults to "a host".
ROSTER_CONTACT=

LOG_LEVEL=INFO
